@model Vahicle_Rental_System.Models.Booking
@{
    ViewData["Title"] = "Booking Receipt";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int totalDays = (int)(Model.ReturnDate - Model.PickupDate).TotalDays;
    if (totalDays <= 0) totalDays = 1;
}

<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('/images/bg_3.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-start">
            <div class="col-md-9 ftco-animate pb-5">
                <p class="breadcrumbs">
                    <span class="mr-2"><a href="@Url.Action("Index", "Home")">Home <i class="ion-ios-arrow-forward"></i></a></span>
                    <span>Receipt <i class="ion-ios-arrow-forward"></i></span>
                </p>
                <h1 class="mb-3 bread">Booking Receipt</h1>
            </div>
        </div>
    </div>
</section>

<style>
    .receipt-container {
        padding: 60px 0;
        background: #f8f9fa;
    }

    .receipt-card {
        border: none;
        border-radius: 20px;
        background: white;
        box-shadow: 0 15px 45px rgba(0,0,0,0.07);
        padding: 50px;
        overflow: hidden;
    }

    .status-badge {
        background-color: rgba(1, 210, 142, 0.1);
        color: #01d28e;
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 13px;
    }

    .theme-green {
        color: #01d28e;
    }

    .detail-item {
        border-bottom: 1px solid #f0f0f0;
        padding: 15px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .detail-label {
        color: #888;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
    }

    .detail-value {
        font-weight: 700;
        color: #333;
    }

    .location-summary {
        background: #fbfbfb;
        border-radius: 12px;
        padding: 20px;
        margin-top: 25px;
        border: 1px solid #f0f0f0;
    }

    .btn-print {
        background: #01d28e;
        color: white;
        padding: 15px 35px;
        border-radius: 8px;
        font-weight: 700;
        text-transform: uppercase;
        border: none;
        transition: 0.3s;
        cursor: pointer;
    }

        .btn-print:hover {
            background: #01b47a;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(1, 210, 142, 0.3);
            color: white;
        }
</style>

<section class="receipt-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="receipt-card">
                    <div class="text-center mb-5">
                        <i class="ion-ios-checkmark-circle theme-green" style="font-size: 70px;"></i>
                        <h2 class="font-weight-bold mt-3">Payment Successful!</h2>
                        <span class="status-badge">Booking Confirmed</span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 pr-lg-5">
                            <h5 class="font-weight-bold mb-3">Rental Information</h5>
                            <div class="detail-item">
                                <span class="detail-label">Transaction ID</span>
                                <span class="detail-value">@Model.TransactionId</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Vehicle</span>
                                <span class="detail-value">@Model.Car.Brand @Model.Car.Model</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Rental Type</span>
                                <span class="detail-value">@(Model.RentalType == "SelfDrive" ? "Self Drive" : "With Driver")</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Duration</span>
                                <span class="detail-value">@totalDays Day(s)</span>
                            </div>
                            <div class="mt-4 pt-3 text-right">
                                <p class="detail-label mb-1">Total Amount Paid</p>
                                <h3 class="theme-green font-weight-bold">PKR @Model.TotalPrice.ToString("N0")</h3>
                            </div>
                        </div>

                        <div class="col-md-6 mt-4 mt-md-0">
                            <h5 class="font-weight-bold mb-3">Locations</h5>
                            <div class="location-summary">
                                <div class="mb-3">
                                    <p class="detail-label mb-1"><i class="ion-ios-pin theme-green mr-1"></i> Pickup</p>
                                    <p class="mb-0 font-weight-bold small">@Model.PickupLocation</p>
                                </div>
                                <hr />
                                <div>
                                    <p class="detail-label mb-1"><i class="ion-ios-pin theme-green mr-1"></i> Drop-off</p>
                                    <p class="mb-0 font-weight-bold small">@Model.DropoffLocation</p>
                                </div>
                            </div>

                            <div class="mt-3 rounded overflow-hidden shadow-sm" style="height: 150px; background: #eee; border: 1px solid #ddd;">
                                <img src="https://www.google.com/maps/vt/pb=!1m4!1m3!1i13!2i5368!3i3600!2m3!1e0!2sm!3i420120488!3m8!2sen!3spk!5e1105!12m4!1e68!2m2!1sset!2sRoadmap!4e0!5m1!5f2"
                                     class="w-100 h-100" style="object-fit: cover; opacity: 0.8; filter: grayscale(20%);">
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 d-flex justify-content-center">
                        <button onclick="window.print();" class="btn-print mr-3"><i class="ion-ios-print mr-2"></i> Print Receipt</button>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary p-3 px-4 font-weight-bold">Return Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>