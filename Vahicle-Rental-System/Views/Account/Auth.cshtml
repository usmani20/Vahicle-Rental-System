@model Vahicle_Rental_System.Models.RegisterViewModel

@{
    Layout = null;
    bool isRegister = ViewData["IsRegister"] as bool? ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login & Register - CarBook</title>

    <link href="https://fonts.googleapis.com/css?family=Poppins:200,300,400,500,600,700,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/icomoon.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            background: url('@Url.Content("~/images/bg_3.jpg")') no-repeat center center fixed;
            background-size: cover;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            font-family: 'Poppins', sans-serif;
            height: 100vh;
            margin: 0;
            animation: fadeIn 0.8s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.98);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        body::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: -1;
        }

        /* --- HIDE BROWSER DEFAULT EYE ICON --- */
        input::-ms-reveal,
        input::-ms-clear {
            display: none !important;
        }

        .input-validation-error {
            border: 2px solid #ff4d4d !important;
            background-color: #ffe6e6 !important;
        }

        .text-danger {
            color: #ff4d4d;
            font-size: 11px;
            margin-bottom: 5px;
            display: block;
            text-align: left;
            width: 100%;
        }

        h1 {
            font-weight: 700;
            margin: 0;
        }

        p {
            font-size: 14px;
            font-weight: 300;
            line-height: 20px;
            letter-spacing: 0.5px;
            margin: 20px 0 30px;
        }

        span {
            font-size: 12px;
        }

        a {
            color: #333;
            font-size: 14px;
            text-decoration: none;
            margin: 15px 0;
        }

        button {
            border-radius: 20px;
            border: 1px solid #01d28e;
            background-color: #01d28e;
            color: #FFFFFF;
            font-size: 12px;
            font-weight: bold;
            padding: 12px 45px;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            button:active {
                transform: scale(0.95);
            }

            button:focus {
                outline: none;
            }

            button.ghost {
                background-color: transparent;
                border-color: #FFFFFF;
            }

        form {
            background-color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding: 0 50px;
            height: 100%;
            text-align: center;
        }

        input {
            background-color: #f1f1f1;
            border: none;
            padding: 12px 15px;
            margin: 8px 0;
            width: 100%;
            border-radius: 5px;
            transition: all 0.3s ease;
        }

            input:focus {
                background-color: #fff;
                box-shadow: 0 0 5px rgba(1, 210, 142, 0.3);
                outline: none;
            }

        /* --- PASSWORD WRAPPER & EYE ICON --- */
        .password-wrapper {
            position: relative;
            width: 100%;
        }

        .toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #777;
            display: none; /* Hidden until typing starts */
            z-index: 10;
        }

        .input-group {
            position: relative;
            width: 100%;
            display: flex;
            align-items: center;
        }

        .btn-send-otp {
            position: absolute;
            right: 5px;
            top: 50%;
            transform: translateY(-50%);
            background: #333;
            color: #fff;
            border: none;
            padding: 6px 12px;
            font-size: 10px;
            border-radius: 15px;
            cursor: pointer;
            height: 32px;
            z-index: 10;
        }

        .otp-group-hidden {
            display: none !important;
        }

        .container {
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 14px 28px rgba(0,0,0,0.25), 0 10px 10px rgba(0,0,0,0.22);
            position: relative;
            overflow: hidden;
            width: 768px;
            max-width: 100%;
            min-height: 520px;
            transition: transform 0.3s ease;
        }

        .form-container {
            position: absolute;
            top: 0;
            height: 100%;
            transition: all 0.6s ease-in-out;
        }

        .sign-in-container {
            left: 0;
            width: 50%;
            z-index: 2;
        }

        .sign-up-container {
            left: 0;
            width: 50%;
            opacity: 0;
            z-index: 1;
        }

        .container.right-panel-active .sign-in-container {
            transform: translateX(100%);
        }

        .container.right-panel-active .sign-up-container {
            transform: translateX(100%);
            opacity: 1;
            z-index: 5;
            animation: show 0.6s;
        }

        .overlay-container {
            position: absolute;
            top: 0;
            left: 50%;
            width: 50%;
            height: 100%;
            overflow: hidden;
            transition: transform 0.6s ease-in-out;
            z-index: 100;
        }

        .container.right-panel-active .overlay-container {
            transform: translateX(-100%);
        }

        .overlay {
            background: linear-gradient(to right, #000000, #01d28e);
            color: #FFFFFF;
            position: relative;
            left: -100%;
            height: 100%;
            width: 200%;
            transform: translateX(0);
            transition: transform 0.6s ease-in-out;
        }

        .container.right-panel-active .overlay {
            transform: translateX(50%);
        }

        .overlay-panel {
            position: absolute;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding: 0 40px;
            text-align: center;
            top: 0;
            height: 100%;
            width: 50%;
            transform: translateX(0);
            transition: transform 0.6s ease-in-out;
        }

        .overlay-left {
            transform: translateX(-20%);
        }

        .container.right-panel-active .overlay-left {
            transform: translateX(0);
        }

        .overlay-right {
            right: 0;
            transform: translateX(0);
        }

        .container.right-panel-active .overlay-right {
            transform: translateX(20%);
        }

        .social-container {
            margin: 20px 0;
        }

            .social-container a {
                border: 1px solid #DDDDDD;
                border-radius: 50%;
                display: inline-flex;
                justify-content: center;
                align-items: center;
                margin: 0 5px;
                height: 40px;
                width: 40px;
                color: #333;
                text-decoration: none;
                transition: all 0.3s ease;
            }

                .social-container a:hover {
                    background-color: #01d28e;
                    color: white;
                    border-color: #01d28e;
                    transform: translateY(-3px);
                }

        .home-link {
            position: absolute;
            top: 20px;
            left: 20px;
            font-weight: bold;
            color: white;
            background: rgba(0,0,0,0.5);
            padding: 5px 10px;
            border-radius: 5px;
            transition: all 0.3s ease;
        }
    </style>
</head>
<body>

    <a href="@Url.Action("Index", "Home")" class="home-link"><span class="icon-arrow-left"></span> Back to Home</a>

    <div class="container @(isRegister ? "right-panel-active" : "")" id="container">

        <div class="form-container sign-up-container">
            <form asp-action="Register" method="post" id="registerForm">
                <h1 style="color: #01d28e;">Create Account</h1>

                <div class="social-container">
                    <a href="@Url.Action("SocialLogin", "Account", new { provider = "Facebook" })" class="social"><span class="icon-facebook"></span></a>
                    <a href="@Url.Action("SocialLogin", "Account", new { provider = "Google" })" class="social"><span class="icon-google"></span></a>
                    <a href="@Url.Action("SocialLogin", "Account", new { provider = "Microsoft" })" class="social"><span class="icon-envelope"></span></a>
                </div>

                <span>or use your email for registration</span>

                <input asp-for="FullName" placeholder="Full Name" />
                <span asp-validation-for="FullName" class="text-danger"></span>

                <div class="input-group">
                    <input asp-for="Email" id="regEmail" placeholder="Email" />
                    <button type="button" class="btn-send-otp" id="btnSendOtp" onclick="sendOtp()">Send OTP</button>
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
                <span id="otpMessage" style="font-size:10px; margin-bottom:5px; text-align:left; width:100%;"></span>

                <div class="password-wrapper">
                    <input asp-for="Password" id="regPassword" placeholder="Password" oninput="checkInput('regPassword', 'toggleRegPass')" onfocus="showOtpField()" />
                    <span id="toggleRegPass" class="toggle-password" onclick="togglePassword('regPassword', 'toggleRegPass')"><span class="icon-eye"></span></span>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>

                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" id="regConfirmPassword" placeholder="Confirm Password" oninput="checkInput('regConfirmPassword', 'toggleRegConfPass')" onfocus="showOtpField()" />
                    <span id="toggleRegConfPass" class="toggle-password" onclick="togglePassword('regConfirmPassword', 'toggleRegConfPass')"><span class="icon-eye"></span></span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                <div id="otpGroup" class="otp-group-hidden" style="width:100%">
                    <input asp-for="Otp" placeholder="Enter 6-digit OTP" />
                    <span asp-validation-for="Otp" class="text-danger"></span>
                </div>

                <button type="submit">Sign Up</button>
            </form>
        </div>

        <div class="form-container sign-in-container">
            <form asp-action="Login" method="post">
                <h1 style="color: #01d28e;">Sign in</h1>
                <div class="social-container">
                    <a href="@Url.Action("SocialLogin", "Account", new { provider = "Facebook" })" class="social"><span class="icon-facebook"></span></a>
                    <a href="@Url.Action("SocialLogin", "Account", new { provider = "Google" })" class="social"><span class="icon-google"></span></a>
                    <a href="@Url.Action("SocialLogin", "Account", new { provider = "Microsoft" })" class="social"><span class="icon-envelope"></span></a>
                </div>
                <span>or use your account</span>

                <input type="email" name="Email" placeholder="Email" required />

                <div class="password-wrapper">
                    <input type="password" name="Password" id="loginPassword" placeholder="Password" oninput="checkInput('loginPassword', 'toggleLoginPass')" required />
                    <span id="toggleLoginPass" class="toggle-password" onclick="togglePassword('loginPassword', 'toggleLoginPass')"><span class="icon-eye"></span></span>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
                {
                    <span class="text-danger">Invalid login attempt.</span>
                }

                <a href="@Url.Action("ForgotPassword", "Account")">Forgot your password?</a>
                <button type="submit">Sign In</button>
            </form>
        </div>

        <div class="overlay-container">
            <div class="overlay">
                <div class="overlay-panel overlay-left">
                    <h1>Welcome Back!</h1>
                    <p>To keep connected with us please login with your personal info</p>
                    <button class="ghost" id="signIn">Sign In</button>
                </div>
                <div class="overlay-panel overlay-right">
                    <h1>Hello, Friend!</h1>
                    <p>Enter your personal details and start journey with us</p>
                    <button class="ghost" id="signUp">Sign Up</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        const signUpButton = document.getElementById('signUp');
        const signInButton = document.getElementById('signIn');
        const container = document.getElementById('container');

        signUpButton.addEventListener('click', () => container.classList.add("right-panel-active"));
        signInButton.addEventListener('click', () => container.classList.remove("right-panel-active"));

        function showOtpField() { $("#otpGroup").removeClass("otp-group-hidden"); }

        function checkInput(inputId, iconId) {
            let input = document.getElementById(inputId);
            let iconBtn = document.getElementById(iconId);
            if (input.value.length > 0) {
                iconBtn.style.display = "block";
            } else {
                iconBtn.style.display = "none";
            }
        }

        function togglePassword(inputId, toggleId) {
            let input = document.getElementById(inputId);
            let iconSpan = document.getElementById(toggleId).querySelector('span');
            if (input.type === "password") {
                input.type = "text";
                iconSpan.classList.replace('icon-eye', 'icon-eye-slash');
            } else {
                input.type = "password";
                iconSpan.classList.replace('icon-eye-slash', 'icon-eye');
            }
        }

        function startCountdown() {
            let seconds = 30;
            const btn = $("#btnSendOtp");
            btn.prop("disabled", true);
            let timer = setInterval(() => {
                seconds--;
                if (seconds > 0) btn.text(`Resend in ${seconds}s`);
                else {
                    clearInterval(timer);
                    btn.text("Resend Code").prop("disabled", false);
                }
            }, 1000);
        }

        function sendOtp() {
            let email = $("#regEmail").val();
            if (!email) { $("#otpMessage").text("Enter email first").css("color", "red"); return; }
            $("#btnSendOtp").prop("disabled", true).text("Sending...");
            $.post('@Url.Action("SendOtp", "Account")', { email: email }, function(res) {
                if (res.success) {
                    $("#otpMessage").text(res.message).css("color", "#01d28e");
                    startCountdown();
                } else {
                    $("#otpMessage").text(res.message).css("color", "red");
                    $("#btnSendOtp").prop("disabled", false).text("Send OTP");
                }
            });
        }
    </script>
</body>
</html>