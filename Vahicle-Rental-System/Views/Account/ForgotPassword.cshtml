@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - CarBook</title>
    <link href="https://fonts.googleapis.com/css?family=Poppins:200,300,400,500,600,700,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/icomoon.css">

    <style>
        * { box-sizing: border-box; }
        body {
            background: url('@Url.Content("~/images/bg_3.jpg")') no-repeat center center fixed;
            background-size: cover;
            display: flex; justify-content: center; align-items: center;
            font-family: 'Poppins', sans-serif; height: 100vh; margin: 0;
        }
        body::before {
            content: ""; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5); z-index: -1;
        }

        .container {
            background-color: #fff; border-radius: 10px;
            box-shadow: 0 14px 28px rgba(0,0,0,0.25), 0 10px 10px rgba(0,0,0,0.22);
            position: relative; overflow: hidden; width: 400px; max-width: 100%; min-height: 480px;
            display: flex; flex-direction: column; align-items: center; justify-content: center; 
            padding: 40px; text-align: center;
            animation: show 0.6s ease-in-out;
        }

        @@keyframes show {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        h1 { color: #01d28e; font-weight: 700; margin: 0 0 10px 0; font-size: 24px; }
        p { font-size: 13px; color: #666; line-height: 1.5; margin-bottom: 20px; }

        input {
            background-color: #f1f1f1; border: none; padding: 12px 15px;
            margin: 8px 0; width: 100%; border-radius: 5px; font-family: inherit;
        }

        /* Password wrapper for the eye icon */
        .password-wrapper { position: relative; width: 100%; }
        .toggle-btn {
            position: absolute; right: 15px; top: 50%; transform: translateY(-50%);
            cursor: pointer; color: #01d28e; font-size: 18px; z-index: 10;
        }

        button {
            border-radius: 20px; border: 1px solid #01d28e; background-color: #01d28e;
            color: #FFFFFF; font-size: 12px; font-weight: bold; padding: 12px 45px;
            letter-spacing: 1px; text-transform: uppercase; transition: transform 80ms ease-in, background 0.3s;
            cursor: pointer; margin-top: 20px; width: 100%;
        }
        button:active { transform: scale(0.95); }
        button:disabled { opacity: 0.7; cursor: not-allowed; }

        .back-link { color: #333; font-size: 14px; text-decoration: none; margin-top: 25px; display: inline-block; transition: 0.3s; }
        .back-link:hover { color: #01d28e; }

        /* Animation for step switching */
        .step-content {
            width: 100%;
            transition: all 0.5s ease-in-out;
        }
        .hidden { display: none; opacity: 0; }

        /* Loading Spinner */
        .spinner {
            display: none; width: 18px; height: 18px;
            border: 2px solid rgba(255,255,255,.3); border-radius: 50%;
            border-top-color: #fff; animation: spin 1s ease-in-out infinite;
            margin-left: 10px; vertical-align: middle;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }

        #statusMessage { font-size: 12px; margin-bottom: 10px; font-weight: 500; height: 18px; }
    </style>
</head>
<body>

    <div class="container">
        <h1>Reset Password</h1>
        <div id="statusMessage"></div>

        <div id="step1" class="step-content">
            <p>Enter your email address and we'll send you a 6-digit code to reset your password.</p>
            <input type="email" id="emailInput" placeholder="Email Address" required />
            <button id="sendBtn" onclick="sendResetCode()">
                <span id="btnText">Send Code</span>
                <div id="btnSpinner" class="spinner"></div>
            </button>
        </div>

        <div id="step2" class="step-content hidden">
            <p>Please enter the verification code sent to your email and choose a new password.</p>
            <input type="text" id="otpInput" placeholder="6-Digit OTP" maxlength="6" />
            
            <div class="password-wrapper">
                <input type="password" id="newPassInput" class="pass-field" placeholder="New Password" />
                <span class="toggle-btn" onclick="togglePass(this)"><i class="icon-eye"></i></span>
            </div>
            
            <button id="resetBtn" onclick="resetPass()">
                Update Password
            </button>
        </div>

        <a href="@Url.Action("Login", "Account")" class="back-link">
            <span class="icon-arrow-left"></span> Back to Login
        </a>
    </div>

    <script>
        function sendResetCode() {
            const email = document.getElementById('emailInput').value;
            const status = document.getElementById('statusMessage');
            const btnText = document.getElementById('btnText');
            const spinner = document.getElementById('btnSpinner');
            const btn = document.getElementById('sendBtn');

            if (!email) {
                status.innerText = "Email is required";
                status.style.color = "red";
                return;
            }

            // Show Loading
            btn.disabled = true;
            spinner.style.display = "inline-block";
            btnText.innerText = "Sending...";

            fetch('/Account/ForgotPassword?email=' + encodeURIComponent(email), { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                status.innerText = data.message;
                status.style.color = data.success ? "#01d28e" : "red";
                
                if (data.success) {
                    // Smooth Transition to Step 2
                    document.getElementById('step1').style.opacity = "0";
                    setTimeout(() => {
                        document.getElementById('step1').classList.add('hidden');
                        document.getElementById('step2').classList.remove('hidden');
                        setTimeout(() => { document.getElementById('step2').style.opacity = "1"; }, 50);
                    }, 400);
                } else {
                    btn.disabled = false;
                    spinner.style.display = "none";
                    btnText.innerText = "Send Code";
                }
            })
            .catch(() => {
                status.innerText = "Connection error. Try again.";
                status.style.color = "red";
                btn.disabled = false;
                spinner.style.display = "none";
            });
        }

        function resetPass() {
            const email = document.getElementById('emailInput').value;
            const otp = document.getElementById('otpInput').value;
            const pass = document.getElementById('newPassInput').value;
            const status = document.getElementById('statusMessage');

            if (!otp || !pass) { status.innerText = "Fill all fields"; status.style.color="red"; return; }

            const formData = new FormData();
            formData.append('email', email);
            formData.append('otp', otp);
            formData.append('newPassword', pass);

            fetch('/Account/ResetPassword', { method: 'POST', body: formData })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert("Success! Your password has been updated.");
                    window.location.href = '/Account/Login';
                } else {
                    status.innerText = data.message;
                    status.style.color = "red";
                }
            });
        }

        function togglePass(btn) {
            const input = btn.parentElement.querySelector('.pass-field');
            const icon = btn.querySelector('i');
            if (input.type === "password") {
                input.type = "text";
                icon.className = "icon-eye-blocked";
            } else {
                input.type = "password";
                icon.className = "icon-eye";
            }
        }
    </script>
</body>
</html>