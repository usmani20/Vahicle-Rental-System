@{
    ViewData["Title"] = "Contact Us";
    ViewData["ActivePage"] = "Contact";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .contact-form {
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        background: #fff;
    }

    .form-control {
        border: 2px solid #eee;
        height: 55px !important;
        border-radius: 10px;
        transition: all 0.3s;
    }

        .form-control:focus {
            border-color: #01d28e;
            box-shadow: none;
            background: #fff;
        }

    textarea.form-control {
        height: auto !important;
    }

    /* Target the specific ID for the map */
    #map {
        height: 450px;
        width: 100%;
        border-radius: 15px;
        margin-top: 30px;
        position: relative;
        z-index: 1;
        background-color: #eee;
    }

    .info-box {
        transition: transform 0.3s;
    }

        .info-box:hover {
            transform: translateY(-5px);
        }
</style>

<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('/images/bg_3.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-start">
            <div class="col-md-9 ftco-animate pb-5">
                <p class="breadcrumbs">
                    <span class="mr-2"><a href="@Url.Action("Index", "Home")">Home <i class="ion-ios-arrow-forward"></i></a></span>
                    <span>Contact <i class="ion-ios-arrow-forward"></i></span>
                </p>
                <h1 class="mb-3 bread">Contact Us</h1>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section contact-section">
    <div class="container">
        <div class="row d-flex mb-5 contact-info">
            <div class="col-md-4">
                <div class="row mb-5">
                    <div class="col-md-12">
                        <div class="border info-box w-100 p-4 rounded mb-2 d-flex align-items-center bg-white shadow-sm">
                            <div class="icon mr-3"><span class="icon-map-o" style="color: #01d28e;"></span></div>
                            <p class="mb-0"><span>Address:</span> SZABIST UNIVERSITY, Clifton, Karachi</p>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="border info-box w-100 p-4 rounded mb-2 d-flex align-items-center bg-white shadow-sm">
                            <div class="icon mr-3"><span class="icon-mobile-phone" style="color: #01d28e;"></span></div>
                            <p class="mb-0"><span>Phone:</span> <a href="tel:923172796345">+92 317 2796345</a></p>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="border info-box w-100 p-4 rounded mb-2 d-flex align-items-center bg-white shadow-sm">
                            <div class="icon mr-3"><span class="icon-envelope-o" style="color: #01d28e;"></span></div>
                            <p class="mb-0"><span>Email:</span> <a href="mailto:carbooooooooook@gmail.com">carbooooooooook@@gmail.com</a></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8 block-9 mb-md-5">
                <form asp-controller="Home" asp-action="Contact" method="post" class="bg-white p-5 contact-form border">
                    <h3 class="mb-4" style="font-weight: 700;">Get in Touch</h3>
                    <div class="form-group">
                        <input type="text" name="name" class="form-control" placeholder="Full Name" required>
                    </div>
                    <div class="form-group">
                        <input type="email" name="email" class="form-control" placeholder="Email Address" required>
                    </div>
                    <div class="form-group">
                        <input type="text" name="subject" class="form-control" placeholder="Subject" required>
                    </div>
                    <div class="form-group">
                        <textarea name="message" cols="30" rows="5" class="form-control" placeholder="How can we help you?" required></textarea>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary py-3 px-5 btn-block" style="border-radius: 10px; font-weight: 600;">
                            Send Message
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div id="map" class="shadow-sm border"></div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // DISABLE GOOGLE MAPS: We force-stop any background google map functions
        var google = null;

        // Initialize OpenStreetMap (Leaflet)
        function initLeafletMap() {
            var szabistCoords = [24.8152, 67.0326]; // SZABIST Karachi
            var map = L.map('map').setView(szabistCoords, 16);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            L.marker(szabistCoords).addTo(map)
                .bindPopup('<b>SZABIST UNIVERSITY</b>')
                .openPopup();

            // Fix for map loading in grey tiles
            setTimeout(function(){ map.invalidateSize(); }, 400);
        }

        // Run map after everything is loaded
        $(document).ready(function() {
            initLeafletMap();
        });

        // SweetAlert Popups
        @if (TempData["Success"] != null)
        {
                <text>
                Swal.fire({
                    title: 'Thank You!',
                    text: '@TempData["Success"]',
                    icon: 'success',
                    confirmButtonColor: '#01d28e'
                });
                </text>
        }

        @if (ViewBag.Error != null)
        {
                <text>
                Swal.fire({
                    title: 'Oops!',
                    text: '@ViewBag.Error',
                    icon: 'error',
                    confirmButtonColor: '#ff4d4d'
                });
                </text>
        }
    </script>
}