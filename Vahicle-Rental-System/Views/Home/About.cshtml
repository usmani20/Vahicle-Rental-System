@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('/images/bg_3.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-start">
            <div class="col-md-9 ftco-animate pb-5">
                <p class="breadcrumbs">
                    <span class="mr-2">
                        <a href="@Url.Action("Index", "Home")">Home <i class="ion-ios-arrow-forward"></i></a>
                    </span>
                    <span>About us <i class="ion-ios-arrow-forward"></i></span>
                </p>
                <h1 class="mb-3 bread">About Us</h1>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section ftco-about">
    <div class="container">
        <div class="row no-gutters">
            <div class="col-md-6 p-md-5 img img-2 d-flex justify-content-center align-items-center" style="background-image: url('/images/about.jpg');">
            </div>
            <div class="col-md-6 wrap-about ftco-animate">
                <div class="heading-section heading-section-white pl-md-5">
                    <span class="subheading">Our Story</span>
                    <h2 class="mb-4">Welcome to Carbook</h2>

                    <p>At Carbook, we believe that the journey is just as important as the destination. Established to redefine the vehicle rental experience in Karachi, we provide a seamless bridge between you and the open road. Our mission is to offer premium, well-maintained vehicles that cater to every need—be it a professional business meeting or a family getaway.</p>
                    <p>We pride ourselves on transparency, reliability, and exceptional customer service. From compact city cars to luxury sedans, our fleet is equipped with modern features to ensure your safety and comfort. Whether you choose our self-drive option for total freedom or our professional chauffeur service for a relaxed ride, we are committed to making your travel experience unforgettable.</p>
                    <p><a href="@Url.Action("Cars", "Home")" class="btn btn-primary py-3 px-4">Browse Our Fleet</a></p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section ftco-intro" style="background-image: url('/images/bg_3.jpg');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10 heading-section heading-section-white ftco-animate text-center">
                <h2 class="mb-4" style="font-style: italic; font-size: 32px; font-weight: 700; line-height: 1.3;">
                    "The greatest part of a road trip isn't arriving;<br>it's the wild stuff that happens along the way."
                </h2>
                <a href="@Url.Action("Contact", "Home")" class="btn btn-primary btn-lg mt-3">Get In Touch</a>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section testimony-section bg-light">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 text-center heading-section ftco-animate">
                <span class="subheading">Executive Team ( THE CODERS ) </span>
                <h2 class="mb-3">Our Founding Members</h2>
            </div>
        </div>

        <div class="row ftco-animate d-flex align-items-stretch">
            <div class="col-md-3 mb-4 d-flex">
                <div class="testimony-wrap rounded text-center py-4 pb-5 shadow-sm bg-white w-100 h-100">
                    <div class="user-img mb-2" style="background-image: url('/images/aftab.jpeg')">
                    </div>
                    <div class="text pt-4">
                        <p class="name mb-0">Aftab Ahmed Samoo</p>
                        <span class="position" style="color: #01d28e; font-weight: 700;">Founder</span>
                        <p class="mt-3 small text-muted">Visionary leader driving the strategic direction and growth of Carbook.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4 d-flex">
                <div class="testimony-wrap rounded text-center py-4 pb-5 shadow-sm bg-white w-100 h-100">
                    <div class="user-img mb-2" style="background-image: url('/images/sabih.jpeg')">
                    </div>
                    <div class="text pt-4">
                        <p class="name mb-0">Sabih Usmani</p>
                        <span class="position" style="color: #01d28e; font-weight: 700;">Co-Founder</span>
                        <p class="mt-3 small text-muted">Expert in operational excellence and ensuring seamless rental experiences.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4 d-flex">
                <div class="testimony-wrap rounded text-center py-4 pb-5 shadow-sm bg-white w-100 h-100">
                    <div class="user-img mb-2" style="background-image: url('/images/laiba.jpeg')">
                    </div>
                    <div class="text pt-4">
                        <p class="name mb-0">Laiba Aamir</p>
                        <span class="position" style="color: #01d28e; font-weight: 700;">Co-Founder</span>
                        <p class="mt-3 small text-muted">Focused on customer engagement and developing our premium brand identity.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4 d-flex">
                <div class="testimony-wrap rounded text-center py-4 pb-5 shadow-sm bg-white w-100 h-100">
                    <div class="user-img mb-2" style="background-image: url('/images/jav.jpeg')">
                    </div>
                    <div class="text pt-4">
                        <p class="name mb-0">Javeria Masroor</p>
                        <span class="position" style="color: #01d28e; font-weight: 700;">Co-Founder</span>
                        <p class="mt-3 small text-muted">Managing strategic partnerships and fleet quality standards.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-counter ftco-section img" id="section-counter">
    <div class="overlay"></div>
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-lg-3 justify-content-center counter-wrap ftco-animate">
                <div class="block-18">
                    <div class="text text-border d-flex align-items-center">
                        <strong class="number" data-number="5">0</strong>
                        <span>Years <br>Experience</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 justify-content-center counter-wrap ftco-animate">
                <div class="block-18">
                    <div class="text text-border d-flex align-items-center">
                        <strong class="number" data-number="150">0</strong>
                        <span>Total <br>Cars</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 justify-content-center counter-wrap ftco-animate">
                <div class="block-18">
                    <div class="text text-border d-flex align-items-center">
                        <strong class="number" data-number="2500">0</strong>
                        <span>Happy <br>Customers</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 justify-content-center counter-wrap ftco-animate">
                <div class="block-18">
                    <div class="text d-flex align-items-center">
                        <strong class="number" data-number="12">0</strong>
                        <span>Total <br>Branches</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>