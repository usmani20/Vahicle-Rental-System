@model IEnumerable<Vahicle_Rental_System.Models.Car>
@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Category Icons Styling matched to site theme */
    .category-wrap {
        display: block;
        background: #fff;
        border-radius: 15px;
        transition: all 0.3s ease;
        border: 1px solid rgba(0, 0, 0, 0.05);
        margin-bottom: 20px;
        height: 100%;
        text-decoration: none !important;
        padding: 40px 10px;
    }

        .category-wrap:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            border-color: #01d28e;
        }

    /* Icon Specific Styling matched to Header Search Icon (Black icon in grey circle) */
    .category-icon .cat-icon {
        font-size: 40px;
        color: #000000;
        margin-bottom: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
        width: 80px;
        height: 80px;
        background: rgba(0, 0, 0, 0.05);
        border-radius: 50%;
    }

    .category-wrap:hover .cat-icon {
        background: #01d28e;
        color: #fff;
    }

    .category-icon h3 {
        font-size: 18px;
        font-weight: 700;
        color: #000;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .category-icon p {
        font-size: 12px;
        margin-bottom: 0;
        color: #666;
        font-style: italic;
    }

    /* Owl Carousel Dots Styling matched to theme green */
    .owl-dots {
        text-align: center;
        margin-top: 30px;
    }

    .owl-dot {
        width: 10px;
        height: 10px;
        background: #ccc !important;
        margin: 0 5px;
        border-radius: 50%;
        display: inline-block;
        outline: none;
    }

        .owl-dot.active {
            background: #01d28e !important;
            width: 30px;
            border-radius: 5px;
        }
</style>

<div class="hero-wrap ftco-degree-bg" style="background-image: url('/images/bg_1.jpg');" data-stellar-background-ratio="0.5">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text justify-content-start align-items-center justify-content-center">
            <div class="col-lg-8 ftco-animate">
                <div class="text w-100 text-center mb-md-5 pb-md-5">
                    <h1 class="mb-4" style="font-weight: 800;">Drive the Experience</h1>
                    <p style="font-size: 18px;">Elite fleet at your fingertips. Experience the road like never before with premium vehicles tailored for every journey.</p>
                    <a href="https://vimeo.com/45830194" class="icon-wrap popup-vimeo d-flex align-items-center mt-4 justify-content-center">
                        <div class="icon d-flex align-items-center justify-content-center">
                            <span class="ion-ios-play"></span>
                        </div>
                        <div class="heading-title ml-5">
                            <span>Watch our rental guide</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section ftco-no-pt bg-light">
    <div class="container-fluid px-0">
        <div class="row no-gutters">
            <div class="col-md-12">
                <div class="services-wrap w-100 py-5" style="background: #fff; border-radius: 0;">
                    <div class="container">
                        <h3 class="heading-section mb-5 text-center" style="font-weight: 700;">The Smarter Way to Explore</h3>
                        <div class="row d-flex mb-4">
                            <div class="col-md-4 d-flex align-self-stretch ftco-animate">
                                <div class="services w-100 text-center">
                                    <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-route"></span></div>
                                    <div class="text w-100">
                                        <h3 class="heading mb-2">Unlimited Routes</h3>
                                        <p class="small text-muted">Navigate through Karachi and beyond with GPS-equipped vehicles.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-self-stretch ftco-animate">
                                <div class="services w-100 text-center">
                                    <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-handshake"></span></div>
                                    <div class="text w-100">
                                        <h3 class="heading mb-2">Flexible Packages</h3>
                                        <p class="small text-muted">Choose between Self-Drive or Professional Driver services.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-self-stretch ftco-animate">
                                <div class="services w-100 text-center">
                                    <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-rent"></span></div>
                                    <div class="text w-100">
                                        <h3 class="heading mb-2">Instant Booking</h3>
                                        <p class="small text-muted">Secure your vehicle instantly with our real-time availability system.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section bg-light">
    <div class="container">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 text-center heading-section ftco-animate">
                <h2 class="mb-3" style="font-size: 28px; font-weight: 700;">What type of car are you looking for?</h2>
            </div>
        </div>
        <div class="row justify-content-center">

            <div class="col-md-3 ftco-animate">
                <a href="@Url.Action("Cars", "Home", new { category = "Sports" })" class="category-wrap text-center">
                    <div class="category-icon">
                        <span class="cat-icon ion-ios-speedometer"></span>
                        <h3 class="heading">Sports</h3>
                        <p class="small">High Performance Cars</p>
                    </div>
                </a>
            </div>

            <div class="col-md-3 ftco-animate">
                <a href="@Url.Action("Cars", "Home", new { category = "Standard" })" class="category-wrap text-center">
                    <div class="category-icon">
                        <span class="cat-icon ion-md-car"></span>
                        <h3 class="heading">Standard</h3>
                        <p class="small">Toyota Corolla or similar</p>
                    </div>
                </a>
            </div>

            <div class="col-md-3 ftco-animate">
                <a href="@Url.Action("Cars", "Home", new { category = "Luxury" })" class="category-wrap text-center">
                    <div class="category-icon">
                        <span class="cat-icon ion-logo-model-s"></span>
                        <h3 class="heading">Luxury</h3>
                        <p class="small">Mercedes Benz or similar</p>
                    </div>
                </a>
            </div>

            <div class="col-md-3 ftco-animate">
                <a href="@Url.Action("Cars", "Home", new { category = "SUV" })" class="category-wrap text-center">
                    <div class="category-icon">
                        <span class="cat-icon ion-ios-car"></span>
                        <h3 class="heading">SUV</h3>
                        <p class="small">Land Cruiser or similar</p>
                    </div>
                </a>
            </div>

        </div>
    </div>
</section>

<section class="ftco-section ftco-no-pt bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 heading-section text-center ftco-animate mb-5">
                <span class="subheading">Exclusive Collection</span>
                <h2 class="mb-2">Featured Vehicles</h2>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div id="home-car-carousel" class="carousel-car owl-carousel">

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var car in Model)
                        {
                            <div class="item">
                                <div class="car-wrap rounded ftco-animate">
                                    <div class="img rounded d-flex align-items-end"
                                         style="background-image: url('@(string.IsNullOrEmpty(car.ImageUrl) ? "/images/default_car.jpg" : car.ImageUrl)');">
                                    </div>
                                    <div class="text">
                                        <h2 class="mb-0">
                                            <a asp-controller="Home" asp-action="CarDetails" asp-route-id="@car.Id">@car.Brand @car.Model</a>
                                        </h2>
                                        <div class="d-flex mb-3">
                                            <span class="cat">@(car.Category?.Name ?? "Car")</span>
                                            <p class="price ml-auto">PKR @car.PriceSelfDrive.ToString("N0") <span>/day</span></p>
                                        </div>

                                        <p class="d-flex mb-0 d-block">
                                            @{
                                                var isAdmin = User.Identity.IsAuthenticated &&
                                                User.Identity.Name.Equals("admin@carbook.com", StringComparison.OrdinalIgnoreCase);
                                            }

                                            @if (isAdmin)
                                            {
                                                <a href="@Url.Action("EditCar", "Admin", new { id = car.Id })" class="btn btn-warning py-2 w-100 font-weight-bold">
                                                    Edit Details
                                                </a>
                                            }
                                            else
                                            {
                                                @if (car.IsAvailable)
                                                {
                                                    <a asp-controller="Home" asp-action="CarDetails" asp-route-id="@car.Id" class="btn btn-primary py-2 w-100 font-weight-bold" style="background-color: #01d28e; border: none;">
                                                        Book This Car
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-secondary py-2 w-100 font-weight-bold" disabled style="cursor: not-allowed; background-color: #cccccc !important; border: none; color: #666;">
                                                        Unavailable
                                                    </button>
                                                }
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="item text-center">
                            <h3>No vehicles available at this moment.</h3>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            var carCarousel = $('#home-car-carousel');
            if (carCarousel.length > 0) {
                carCarousel.owlCarousel({
                    center: false,
                    loop: true,
                    items:1,
                    autoplay: true,
                    pauseOnHover: false,
                    margin: 30,
                    stagePadding: 0,
                    nav: false,
                    dots: true,
                    responsive:{
                      0:{
                          items:1,
                          dots: true
                      },
                      600:{
                          items:2,
                          dots: true
                      },
                      1000:{
                          items:3,
                          dots: true
                      }
                    }
                });
            }
        });
    </script>
}