<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        /* 1. Make the dropdown trigger on hover (if not already handled) */
        .navbar .dropdown:hover .dropdown-menu {
            display: block;
        }

        /* 2. THE FIX: Bridge the gap */
        .navbar .dropdown-menu {
            margin-top: 0; /* Removes the gap causing the flicker */
            top: 95%; /* Moves it up slightly to overlap the navbar, ensuring connection */
        }

        /* --- IMPROVED SEARCH UI STYLES --- */
        .nav-search-form {
            position: relative;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 30px;
            padding: 5px;
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            width: 42px;
            height: 42px;
            overflow: hidden;
            display: flex;
            align-items: center;
            box-sizing: border-box;
            margin-left: 15px;
            align-self: center;
        }

            /* Expand on hover or focus */
            .nav-search-form:hover,
            .nav-search-form:focus-within,
            .nav-search-form:valid {
                width: 220px;
                background: #fff;
                border-color: #01d28e; /* Theme Green */
                box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            }

            .nav-search-form input {
                background: transparent;
                border: none;
                outline: none;
                color: #000;
                font-size: 14px;
                width: 100%;
                /* Added padding-right to prevent text from going under the Reset button and Icon */
                padding: 0 85px 0 15px;
                opacity: 0;
                transition: opacity 0.3s;
                height: 100%;
                position: relative;
                z-index: 1;
            }

            .nav-search-form:hover input,
            .nav-search-form:focus-within input,
            .nav-search-form:valid input {
                opacity: 1;
            }

            .nav-search-form .fa-search {
                position: absolute;
                right: 12px;
                color: #fff;
                transition: all 0.3s;
                pointer-events: none;
                font-size: 16px;
                z-index: 2;
            }

            .nav-search-form:hover .fa-search,
            .nav-search-form:focus-within .fa-search,
            .nav-search-form:valid .fa-search {
                color: #01d28e;
            }

        /* --- THE FIX: Position Reset button INSIDE the bar to prevent overlapping nav --- */
        .nav-clear-btn {
            display: none;
            position: absolute;
            right: 35px; /* Aligns to the left of the search icon */
            font-size: 10px;
            background: #eee;
            color: #333;
            border: 1px solid #ddd;
            border-radius: 15px;
            padding: 2px 8px;
            cursor: pointer;
            white-space: nowrap;
            z-index: 3;
            transition: all 0.2s;
        }

            .nav-clear-btn:hover {
                background: #ff4d4d;
                color: #fff;
                border-color: #ff4d4d;
            }

        form.nav-search-form:valid .nav-clear-btn {
            display: block;
        }

        /* Adjust icon color for light navbar mode */
        .ftco-navbar-light .nav-search-form:not(:hover):not(:focus-within):not(:valid) {
            background: rgba(0, 0, 0, 0.05);
            border-color: rgba(0, 0, 0, 0.1);
        }

            .ftco-navbar-light .nav-search-form:not(:hover):not(:focus-within):not(:valid) .fa-search {
                color: #000;
            }
    </style>
    <title>@ViewData["Title"] - Carbook</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link href="https://fonts.googleapis.com/css?family=Poppins:200,300,400,500,600,700,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">

    <link rel="stylesheet" href="~/css/open-iconic-bootstrap.min.css">
    <link rel="stylesheet" href="~/css/animate.css">
    <link rel="stylesheet" href="~/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/css/owl.theme.default.min.css">
    <link rel="stylesheet" href="~/css/magnific-popup.css">
    <link rel="stylesheet" href="~/css/aos.css">
    <link rel="stylesheet" href="~/css/ionicons.min.css">
    <link rel="stylesheet" href="~/css/bootstrap-datepicker.css">
    <link rel="stylesheet" href="~/css/jquery.timepicker.css">
    <link rel="stylesheet" href="~/css/flaticon.css">
    <link rel="stylesheet" href="~/css/icomoon.css">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    @{
        // --- FIX: Navbar Visibility Logic ---
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var navClass = "navbar navbar-expand-lg navbar-dark ftco_navbar bg-dark";

        if (controller != "Admin")
        {
            navClass += " ftco-navbar-light";
        }
    }

    <nav class="@navClass" id="ftco-navbar">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">Car<span>Book</span></a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav" aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="oi oi-menu"></span> Menu
            </button>

            <div class="collapse navbar-collapse" id="ftco-nav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item @(ViewData["ActivePage"] as string == "Home" ? "active" : "")">
                        <a href="@Url.Action("Index", "Home")" class="nav-link">Home</a>
                    </li>
                    @{
                        var isAdmin = User.Identity.IsAuthenticated &&
                        User.Identity.Name.Equals("admin@carbook.com", StringComparison.OrdinalIgnoreCase);
                    }
                    @if (!isAdmin)
                    {

                        <li class="nav-item @(ViewData["ActivePage"] as string == "About" ? "active" : "")">
                            <a href="@Url.Action("About", "Home")" class="nav-link">About</a>
                        </li>
                        <li class="nav-item @(ViewData["ActivePage"] as string == "Services" ? "active" : "")">
                            <a href="@Url.Action("Services", "Home")" class="nav-link">Services</a>
                        </li>
                        <li class="nav-item @(ViewData["ActivePage"] as string == "Cars" ? "active" : "")">
                            <a href="@Url.Action("Cars", "Home")" class="nav-link">Cars</a>
                        </li>
                        <li class="nav-item @(ViewData["ActivePage"] as string == "Contact" ? "active" : "")">
                            <a href="@Url.Action("Contact", "Home")" class="nav-link">Contact</a>
                        </li>
                    }

                    <li class="nav-item d-flex align-items-center">
                        <form class="nav-search-form" asp-controller="Home" asp-action="Cars" method="get">
                            <input type="text" name="searchString" placeholder="Search cars..." required autocomplete="off">
                            <i class="fa fa-search"></i>
                            <button type="button" class="nav-clear-btn" onclick="clearNavInput()">Reset</button>
                        </form>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="profileDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="icon-user"></span>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <span style="font-size: 12px; margin-left: 5px;">
                                    @User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value
                                </span>
                            }
                        </a>

                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="profileDropdown">
                            @if (User.Identity.IsAuthenticated)
                            {
                                /* 1. SECURE ADMIN CHECK (Case-Insensitive) */
                                var userEmail = User.Identity.Name ?? "";
                                if (userEmail.Equals("admin@carbook.com", StringComparison.OrdinalIgnoreCase))
                                {
                                    /* -- ADMIN ONLY -- */
                                    <a class="dropdown-item" href="@Url.Action("Dashboard", "Admin")">
                                        <span class="icon-dashboard mr-2"></span> Admin Dashboard
                                    </a>
                                }
                                else
                                {
                                    /* -- REGULAR USERS ONLY -- */

                                    <a class="dropdown-item" href="@Url.Action("MyBookings", "Booking")">
                                        <span class="icon-list mr-2"></span> My Bookings
                                    </a>

                                    <a class="dropdown-item" href="@Url.Action("EditProfile", "Account")">
                                        <span class="icon-pencil mr-2"></span> Edit Profile
                                    </a>
                                }

                                <div class="dropdown-divider"></div>

                                /* LOGOUT */
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item" style="cursor:pointer;">
                                        <span class="icon-sign-out mr-2"></span> Logout
                                    </button>
                                </form>
                            }
                            else
                            {
                                /* -- GUESTS -- */
                                <a class="dropdown-item" href="@Url.Action("Login", "Account")">
                                    <span class="icon-sign-in mr-2"></span> Login
                                </a>
                                <a class="dropdown-item" href="@Url.Action("Register", "Account")">
                                    <span class="icon-user-plus mr-2"></span> Register
                                </a>
                            }
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="ftco-footer ftco-bg-dark ftco-section">
        <div class="container">
            <div class="row mb-5">
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2"><a href="#" class="logo">Car<span>book</span></a></h2>
                        <p>Providing premium vehicle rental services across Karachi. Whether you need a self-drive experience or a professional chauffeur, we ensure comfort, safety, and reliability for every mile of your journey.</p>
                        <ul class="ftco-footer-social list-unstyled float-md-left float-lft mt-5">
                            <li class="ftco-animate"><a href="#"><span class="icon-twitter"></span></a></li>
                            <li class="ftco-animate"><a href="#"><span class="icon-facebook"></span></a></li>
                            <li class="ftco-animate"><a href="#"><span class="icon-instagram"></span></a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4 ml-md-5">
                        <h2 class="ftco-heading-2">Quick Links</h2>
                        <ul class="list-unstyled">
                            <li><a href="@Url.Action("Index", "Home")" class="py-2 d-block">Home</a></li>
                            <li><a href="@Url.Action("About", "Home")" class="py-2 d-block">About Us</a></li>
                            <li><a href="@Url.Action("Services", "Home")" class="py-2 d-block">Our Services</a></li>
                            <li><a href="@Url.Action("Cars", "Home")" class="py-2 d-block">Choose a Car</a></li>
                            <li><a href="@Url.Action("Contact", "Home")" class="py-2 d-block">Contact Us</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md">
                    <div class="ftco-footer-widget mb-4">
                        <h2 class="ftco-heading-2">Have a Questions?</h2>
                        <div class="block-23 mb-3">
                            <ul>
                                <li><span class="icon icon-map-marker"></span><span class="text">SZABIST UNIVERSITY, 3rd Ave, Block 5 Clifton, Karachi, 75600</span></li>
                                <li><a href="tel:923172796345"><span class="icon icon-phone"></span><span class="text">+92 317 2796345</span></a></li>
                                <li><a href="mailto:carbooooooooook@gmail.com"><span class="icon icon-envelope"></span><span class="text">carbooooooooook@@gmail.com</span></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 text-center">
                    <p>
                        Copyright &copy;
                        <script>document.write(new Date().getFullYear());</script> All rights reserved | This project is made with <i class="icon-heart color-danger" aria-hidden="true"></i> by <a href="#" target="_blank">The Coders Group</a>
                    </p>
                </div>
            </div>
        </div>
    </footer>


    <div id="ftco-loader" class="show fullscreen"><svg class="circular" width="48px" height="48px"><circle class="path-bg" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke="#eeeeee" /><circle class="path" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke-miterlimit="10" stroke="#F96D00" /></svg></div>


    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/jquery-migrate-3.0.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.easing.1.3.js"></script>
    <script src="~/js/jquery.waypoints.min.js"></script>
    <script src="~/js/jquery.stellar.min.js"></script>
    <script src="~/js/owl.carousel.min.js"></script>
    <script src="~/js/jquery.magnific-popup.min.js"></script>
    <script src="~/js/aos.js"></script>
    <script src="~/js/jquery.animateNumber.min.js"></script>
    <script src="~/js/bootstrap-datepicker.js"></script>
    <script src="~/js/jquery.timepicker.min.js"></script>
    <script src="~/js/scrollax.min.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBVWaKrjvy3MaE7SQ74_uJiULgl1JY0H2s&sensor=false"></script>
    <script src="~/js/google-map.js"></script>
    <script src="~/js/main.js"></script>

    <script>
        function clearNavInput() {
            const input = document.querySelector('.nav-search-form input');
            input.value = "";
            window.location.href = '@Url.Action("Cars", "Home")';
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>