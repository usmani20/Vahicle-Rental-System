@model IEnumerable<Vahicle_Rental_System.Models.Car>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@if (TempData["SuccessMessage"] != null)
{
    <div class="container mt-4">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    </div>
}

<div class="container" style="margin-top: 150px; margin-bottom: 50px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Admin Dashboard</h2>
        <a asp-controller="Admin" asp-action="ManageBookings" class="btn btn-info text-white mr-2 shadow-sm">
            <span class="icon-list-alt mr-1"></span> Manage Bookings
        </a>
        <a asp-action="AddCar" class="btn btn-success">
            <span class="icon-plus"></span> Add New Car
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <h4 class="card-title mb-3">Car Inventory</h4>

            @if (!Model.Any())
            {
                <div class="alert alert-warning text-center">
                    No cars found! Click the "Add New Car" button to get started.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle">
                        <thead class="thead-dark">
                            <tr>
                                <th>Image</th>
                                <th>Vehicle Info</th>
                                <th>Pricing Plan</th>
                                <th>Media</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var car in Model)
                            {
                                <tr>
                                    <td style="width: 100px;">
                                        <img src="@car.ImageUrl" style="width: 80px; height: 50px; object-fit: cover; border-radius: 5px;" alt="Car Image" />
                                    </td>

                                    <td>
                                        <strong>@car.Brand @car.Model</strong><br />
                                        <span class="badge badge-secondary">@car.Category?.Name</span>
                                    </td>

                                    <td>
                                        <small class="text-muted">Self:</small> <b>@car.PriceSelfDrive.ToString("N0")</b> <small>PKR</small><br />
                                        <small class="text-muted">Driver:</small> <b>@car.PriceWithDriver.ToString("N0")</b> <small>PKR</small>
                                    </td>

                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(car.VideoUrl))
                                        {
                                            <a href="@car.VideoUrl" target="_blank" class="btn btn-sm btn-outline-info" title="Watch 360 Video">
                                                <span class="icon-play-circle"></span> 360°
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>


                                    <td>
                                        @if (car.IsAvailable)
                                        {
                                            <span class="badge badge-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">Rented</span>
                                        }
                                    </td>

                                    <td>
                                        <form asp-action="DeleteCar" method="post" onsubmit="return confirm('Are you sure you want to delete this car?');">
                                            <input type="hidden" name="id" value="@car.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete Car">
                                                <span class="icon-trash"></span> Delete
                                            </button>
                                        </form>
                                        <a asp-action="EditCar" asp-route-id="@car.Id" class="btn btn-sm btn-warning">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>