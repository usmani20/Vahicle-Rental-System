@model Vahicle_Rental_System.Models.ViewModels.CarViewModel
@{
    ViewData["Title"] = "Edit Vehicle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-management {
        margin-top: 120px;
        margin-bottom: 80px;
    }

    /* Matching your Manage Bookings / Dashboard Cards */
    .form-container {
        border-radius: 15px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #eee;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .section-header-bg {
        background-color: #f8f9fa;
        padding: 15px 25px;
        border-bottom: 1px solid #eee;
    }

    .form-control-custom {
        height: 45px !important;
        border-radius: 8px !important;
        border: 1px solid #eee !important;
        font-size: 14px;
    }

        .form-control-custom:focus {
            border-color: #01d28e !important;
            box-shadow: 0 0 0 0.2rem rgba(1, 210, 142, 0.1) !important;
        }

    .label-header {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #777;
        font-weight: 700;
        margin-bottom: 10px;
        display: block;
    }

    .img-upload-box {
        background: #fcfcfc;
        border: 2px dashed #eee;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }

    /* Buttons matching your theme */
    .btn-update-main {
        background: #01d28e;
        color: #fff;
        font-weight: 700;
        border-radius: 8px;
        padding: 12px 30px;
        border: none;
        transition: 0.3s;
    }

        .btn-update-main:hover {
            background: #01b47a;
            color: #fff;
            transform: translateY(-2px);
        }

    .input-group-text-custom {
        background-color: #f8f9fa;
        border: 1px solid #eee;
        border-right: none;
        border-radius: 8px 0 0 8px;
        color: #01d28e;
        font-weight: 700;
    }
</style>

<div class="container admin-management">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 style="font-weight: 800; color: #222;">Edit Vehicle</h2>
            <p class="text-muted small">Update specifications for <strong>@Model.Brand @Model.Model</strong></p>
        </div>
        <div class="col-md-6 text-md-right">
            <a asp-action="Dashboard" class="btn btn-outline-dark px-4" style="border-radius: 8px; font-weight: 700;">
                <i class="ion-ios-arrow-back mr-2"></i> BACK TO FLEET
            </a>
        </div>
    </div>

    <div class="form-container shadow-sm">
        <form asp-action="EditCar" asp-controller="Admin" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingImageUrl" />

            <div class="section-header-bg">
                <h5 class="mb-0" style="font-weight: 700; color: #333;">Vehicle Information & Pricing</h5>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="row">
                    <div class="col-md-7 border-right pr-md-5">
                        <div class="row">
                            <div class="col-md-12 form-group">
                                <label class="label-header">Vehicle Category</label>
                                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control form-control-custom"></select>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="label-header">Brand</label>
                                <input asp-for="Brand" class="form-control form-control-custom" />
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="label-header">Model</label>
                                <input asp-for="Model" class="form-control form-control-custom" />
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="label-header">Self Drive Rate (24h)</label>
                                <div class="input-group">
                                    <div class="input-group-prepend"><span class="input-group-text-custom px-3">PKR</span></div>
                                    <input asp-for="PriceSelfDrive" type="number" class="form-control form-control-custom" style="border-left:none;" />
                                </div>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="label-header">With Driver Rate (10h)</label>
                                <div class="input-group">
                                    <div class="input-group-prepend"><span class="input-group-text-custom px-3">PKR</span></div>
                                    <input asp-for="PriceWithDriver" type="number" class="form-control form-control-custom" style="border-left:none;" />
                                </div>
                            </div>
                            <div class="col-md-12 form-group mt-2">
                                <label class="label-header">360° Interior Video Link</label>
                                <input asp-for="VideoUrl" class="form-control form-control-custom" placeholder="Paste URL here..." />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5 pl-md-5 mt-4 mt-md-0">
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label class="label-header">Transmission</label>
                                <select asp-for="Transmission" class="form-control form-control-custom">
                                    <option>Automatic</option>
                                    <option>Manual</option>
                                </select>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="label-header">Seats</label>
                                <input asp-for="Seats" type="number" class="form-control form-control-custom" />
                            </div>
                            <div class="col-md-12 form-group">
                                <label class="label-header">Short Description</label>
                                <textarea asp-for="Description" class="form-control form-control-custom" rows="3" style="height:auto !important;"></textarea>
                            </div>
                            <div class="col-md-12 mt-2">
                                <label class="label-header">Vehicle Identity Photo</label>
                                <div class="img-upload-box">
                                    @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                                    {
                                        <img src="@Model.ExistingImageUrl" style="height: 80px; border-radius: 8px; border: 1px solid #eee;" class="mb-3 shadow-sm" />
                                    }
                                    <div class="custom-file" style="cursor: pointer;">
                                        <input asp-for="CarImage" type="file" class="form-control-file" id="upload">
                                        <label class="small text-muted mt-2 d-block" for="upload">Click to change current image</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-5">
                    <div class="col-md-12 text-center">
                        <hr class="mb-4" />
                        <button type="submit" class="btn btn-update-main px-5 shadow">
                            <i class="ion-ios-checkmark-circle mr-2"></i> UPDATE VEHICLE RECORD
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <partial name="_ValidationScriptsPartial" />
}