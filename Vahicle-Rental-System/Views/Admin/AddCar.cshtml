@model Vahicle_Rental_System.Models.ViewModels.CarViewModel
@{
    ViewData["Title"] = "Add New Car";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Premium Theme Form Styling */
    .form-section-title {
        border-left: 5px solid #01d28e;
        padding-left: 15px;
        margin-bottom: 25px;
        font-weight: 700;
        color: #222;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 16px;
    }

    .add-car-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 15px 40px rgba(0,0,0,0.08) !important;
    }

    .label-custom {
        font-weight: 700;
        color: #444;
        font-size: 12px;
        text-transform: uppercase;
        margin-bottom: 10px;
        display: block;
        letter-spacing: 0.5px;
    }

    .form-control-custom {
        border-radius: 10px !important;
        padding: 12px 18px !important;
        border: 1px solid #eee !important;
        height: auto !important;
        background-color: #f9f9f9 !important;
        transition: all 0.3s ease;
        font-size: 14px;
    }

        .form-control-custom:focus {
            background-color: #fff !important;
            border-color: #01d28e !important;
            box-shadow: 0 5px 15px rgba(1, 210, 142, 0.1) !important;
            outline: none;
        }

    .input-group-text {
        background-color: #f1f1f1;
        border: 1px solid #eee;
        border-radius: 10px 0 0 10px;
        font-weight: 800;
        color: #01d28e;
        font-size: 13px;
    }

    .btn-save-vehicle {
        background: #01d28e !important;
        border: none !important;
        padding: 18px 45px !important;
        font-weight: 700 !important;
        border-radius: 50px !important;
        letter-spacing: 1.5px;
        transition: 0.4s all cubic-bezier(0.165, 0.84, 0.44, 1);
    }

        .btn-save-vehicle:hover {
            background: #01b47a !important;
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(1, 180, 122, 0.3);
        }

    .image-upload-wrapper {
        border: 2px dashed #ddd;
        border-radius: 15px;
        padding: 40px;
        background: #fafafa;
        transition: 0.3s;
    }

        .image-upload-wrapper:hover {
            border-color: #01d28e;
            background: #f0fff9;
        }

    .input-validation-error {
        border: 1px solid #ff4d4d !important;
        background-color: #fffafa !important;
    }
</style>

<section class="ftco-section bg-light" style="padding-top: 150px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="mb-4">
                    <h2 style="font-weight: 800; color: #222;">Add Premium Vehicle</h2>
                    <p class="text-muted">Register a new vehicle to the active rental fleet.</p>
                </div>

                <div class="add-car-card p-4 p-md-5">
                    <div asp-validation-summary="All" class="alert alert-danger" style="display:none;"></div>

                    <form asp-action="AddCar" method="post" enctype="multipart/form-data">

                        <div class="form-section-title">
                            <i class="ion-ios-information-circle mr-2" style="color:#01d28e"></i> Identity & Classification
                        </div>
                        <div class="row mb-5">
                            <div class="col-md-4 form-group">
                                <label class="label-custom">Vehicle Category</label>
                                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control form-control-custom">
                                    <option value="">Select Category</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="label-custom">Manufacturer / Brand</label>
                                <input asp-for="Brand" class="form-control form-control-custom" placeholder="e.g., Toyota, BMW" />
                                <span asp-validation-for="Brand" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="label-custom">Model Name</label>
                                <input asp-for="Model" class="form-control form-control-custom" placeholder="e.g., Camry, X5" />
                                <span asp-validation-for="Model" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-section-title">
                            <i class="ion-ios-pricetag mr-2" style="color:#01d28e"></i> Pricing Structures
                        </div>
                        <div class="row mb-5">
                            <div class="col-md-4">
                                <label class="label-custom">Self Drive (24h)</label>
                                <div class="input-group">
                                    <div class="input-group-prepend"><span class="input-group-text">PKR</span></div>
                                    <input asp-for="PriceSelfDrive" type="number" class="form-control form-control-custom" placeholder="0" />
                                </div>
                                <span asp-validation-for="PriceSelfDrive" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="label-custom">With Driver (24h)</label>
                                <div class="input-group">
                                    <div class="input-group-prepend"><span class="input-group-text">PKR</span></div>
                                    <input asp-for="PriceWithDriver" type="number" class="form-control form-control-custom" placeholder="0" />
                                </div>
                                <span asp-validation-for="PriceWithDriver" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="label-custom">Overtime (per hour)</label>
                                <div class="input-group">
                                    <div class="input-group-prepend"><span class="input-group-text">PKR</span></div>
                                    <input asp-for="OvertimeRate" type="number" class="form-control form-control-custom" placeholder="0" />
                                </div>
                            </div>
                        </div>

                        <div class="form-section-title">
                            <i class="ion-ios-settings mr-2" style="color:#01d28e"></i> Technical Attributes
                        </div>
                        <div class="row mb-5">
                            <div class="col-md-3 form-group">
                                <label class="label-custom">Fuel Source</label>
                                <select asp-for="FuelType" class="form-control form-control-custom">
                                    <option>Petrol</option>
                                    <option>Diesel</option>
                                    <option>Electric</option>
                                    <option>Hybrid</option>
                                </select>
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="label-custom">Transmission</label>
                                <select asp-for="Transmission" class="form-control form-control-custom">
                                    <option>Automatic</option>
                                    <option>Manual</option>
                                </select>
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="label-custom">Passenger Seats</label>
                                <input asp-for="Seats" type="number" class="form-control form-control-custom" />
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="label-custom">Luggage Space</label>
                                <input asp-for="Luggage" class="form-control form-control-custom" placeholder="e.g., 3 Bags" />
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="label-custom">Fuel Policy</label>
                                <input asp-for="FuelPolicy" class="form-control form-control-custom" placeholder="e.g., Full to Full" />
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="label-custom">360° YouTube Tour URL</label>
                                <input asp-for="VideoUrl" class="form-control form-control-custom" placeholder="https://youtube.com/watch?v=..." />
                            </div>
                            <div class="col-md-12 form-group">
                                <label class="label-custom">Vehicle Highlights</label>
                                <textarea asp-for="Description" class="form-control form-control-custom" rows="3" placeholder="Enter key features or conditions..."></textarea>
                            </div>
                        </div>

                        <div class="form-section-title">
                            <i class="ion-ios-images mr-2" style="color:#01d28e"></i> Visual Assets
                        </div>
                        <div class="row mb-5">
                            <div class="col-md-12">
                                <div class="image-upload-wrapper text-center">
                                    <i class="ion-ios-cloud-upload" style="font-size: 50px; color: #01d28e;"></i>
                                    <h5 class="mt-3 mb-1" style="font-weight:700;">Upload Vehicle Photo</h5>
                                    <p class="text-muted small mb-4">Recommended size: 1200x800px (Transparent or White BG).</p>
                                    <input asp-for="CarImage" type="file" class="form-control-file d-inline-block" style="font-size: 14px; color: #666;" />
                                    <div class="mt-2">
                                        <span asp-validation-for="CarImage" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-save-vehicle btn-lg text-white px-5 shadow">
                                <i class="ion-ios-checkmark-circle mr-2"></i> ADD TO INVENTORY
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}