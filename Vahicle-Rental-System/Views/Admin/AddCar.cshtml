@model Vahicle_Rental_System.Models.ViewModels.CarViewModel
@{
    ViewData["Title"] = "Add New Car";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .input-validation-error {
        border: 2px solid #ff4d4d !important;
        background-color: #ffe6e6 !important;
    }

    .text-danger {
        color: #ff4d4d;
        font-size: 12px;
        font-weight: bold;
        display: block;
        margin-top: 5px;
    }
</style>

<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Add Vehicle Details</h4>
                </div>
                <div class="card-body">

                    <div asp-validation-summary="All" class="alert alert-danger" style="display:none;"></div>

                    <form asp-action="AddCar" method="post" enctype="multipart/form-data">

                        <h6 class="text-primary mt-3">Basic Information</h6>
                        <hr />
                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label>Category <span style="color:red">*</span></label>
                                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Brand <span style="color:red">*</span></label>
                                <input asp-for="Brand" class="form-control" placeholder="Honda" />
                                <span asp-validation-for="Brand" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Model <span style="color:red">*</span></label>
                                <input asp-for="Model" class="form-control" placeholder="Civic" />
                                <span asp-validation-for="Model" class="text-danger"></span>
                            </div>
                        </div>

                        <h6 class="text-primary mt-4">Pricing & Policies</h6>
                        <hr />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card bg-light mb-3">
                                    <div class="card-body pt-2 pb-2">
                                        <label class="font-weight-bold">Self Drive Price (24hrs) <span style="color:red">*</span></label>
                                        <div class="input-group">
                                            <div class="input-group-prepend"><span class="input-group-text">PKR</span></div>
                                            <input asp-for="PriceSelfDrive" type="number" class="form-control" placeholder="8500" />
                                        </div>
                                        <span asp-validation-for="PriceSelfDrive" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light mb-3">
                                    <div class="card-body pt-2 pb-2">
                                        <label class="font-weight-bold">With Driver Price (10hrs) <span style="color:red">*</span></label>
                                        <div class="input-group">
                                            <div class="input-group-prepend"><span class="input-group-text">PKR</span></div>
                                            <input asp-for="PriceWithDriver" type="number" class="form-control" placeholder="11000" />
                                        </div>
                                        <span asp-validation-for="PriceWithDriver" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label>Overtime Rate (Per Hour)</label>
                                <input asp-for="OvertimeRate" type="number" class="form-control" placeholder="350" />
                            </div>
                            <div class="col-md-6 form-group">
                                <label>Fuel Policy</label>
                                <input asp-for="FuelPolicy" class="form-control" placeholder="Refill or pay PKR 40/KM" />
                            </div>
                        </div>

                        <h6 class="text-primary mt-4">Specifications & Media</h6>
                        <hr />
                        <div class="row">
                            <div class="col-md-4 form-group">
                                <label>Fuel Type</label>
                                <select asp-for="FuelType" class="form-control">
                                    <option>Petrol</option>
                                    <option>Diesel</option>
                                    <option>Electric</option>
                                    <option>Hybrid</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Mileage (e.g. 14 km/l)</label>
                                <input asp-for="Mileage" class="form-control" placeholder="12 km/l" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Luggage (e.g. 2 Bags)</label>
                                <input asp-for="Luggage" class="form-control" placeholder="2 Bags" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Transmission</label>
                                <select asp-for="Transmission" class="form-control">
                                    <option>Automatic</option>
                                    <option>Manual</option>
                                </select>
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Seats</label>
                                <input asp-for="Seats" type="number" class="form-control" value="5" />
                            </div>
                            <div class="col-md-4 form-group">
                                <label>360° Video URL (Optional)</label>
                                <input asp-for="VideoUrl" class="form-control" placeholder="https://youtube.com/..." />
                                <span asp-validation-for="VideoUrl" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Description</label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="form-group">
                            <label>Upload Image <span style="color:red">*</span></label>
                            <input asp-for="CarImage" type="file" class="form-control-file" />
                            <span asp-validation-for="CarImage" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg btn-block mt-4">Save Vehicle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}